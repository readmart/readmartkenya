# ReadMart Environment Variables Example
# Copy this file to .env and fill in the actual values

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Authentication
JWT_SECRET=at_least_32_characters_long_random_string
FOUNDER_EMAIL=admin@readmartke.com
FOUNDER_PASSWORD=secure_password_here

# Email (Resend)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=ReadMart <notifications@yourdomain.com>
SUPPORT_EMAIL=support@yourdomain.com

# Payments (KopoKopo)
# These values must match the credentials from the KopoKopo Applications dashboard.
# In production all of them are REQUIRED – the backend will fail fast if any are missing.
KOPOKOPO_CLIENT_ID=your_client_id
KOPOKOPO_CLIENT_SECRET=your_client_secret
KOPOKOPO_API_KEY=your_api_key              # Used for webhook signature verification
KOPOKOPO_TILL_NUMBER=your_till_number      # Online Payments Till Number
KOPOKOPO_WEBHOOK_SECRET=                  # Optional: override for webhook HMAC secret instead of KOPOKOPO_API_KEY
KOPOKOPO_WEBHOOK_URL=https://readmartke.com/api/kopokopo/webhook
KOPOKOPO_BASE_URL=https://api.kopokopo.com
KOPOKOPO_ENV=production

# Platform
PUBLIC_DOMAIN=yourdomain.com
VERCEL_URL=your-project.vercel.app

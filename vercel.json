{ 
  "rewrites": [ 
    { "source": "/api/auth/(.*)", "destination": "/api/auth?action=$1" }, 
    { "source": "/api/health", "destination": "/api/auth?action=health" },
    { "source": "/api/reminders", "destination": "/api/emails?action=reminders" },
    { "source": "/api/contact", "destination": "/api/newsletter?action=contact" },
    { "source": "/api/payments/webhook", "destination": "/api/payments?webhook=true" }, 
    { "source": "/api/kopokopo/webhook", "destination": "/api/payments?webhook=true" }, 
    { "source": "/api/payments/(.*)", "destination": "/api/payments?action=$1" }, 
    { "source": "/api/kopokopo/(.*)", "destination": "/api/payments?action=$1" }, 
    { "source": "/api/community/(.*)", "destination": "/api/community?action=$1" },
    { "source": "/api/orders/(.*)", "destination": "/api/orders?action=$1" },
    { "source": "/api/ebooks/(.*)", "destination": "/api/products?action=ebooks&ebookId=$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" }, 
    { "source": "/((?!api/|@|src/|node_modules/|assets/|favicon.ico|logo.jpg|vite.svg).*)", "destination": "/index.html" } 
  ], 
  "headers": [ 
    { 
      "source": "/api/(.*)", 
      "headers": [ 
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" }, 
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, x-kopokopo-signature, x-k2-signature" },
        { "key": "X-Frame-Options", "value": "DENY" } 
      ] 
    } 
  ] 
} 
